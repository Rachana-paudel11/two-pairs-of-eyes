# Server Port
PORT=5000

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/two_pairs_of_eyes

# Authentication Secret (HMAC-SHA256 token signing - must be at least 32 characters in production)
JWT_SECRET=your_jwt_hmac_sha256_secret_key_at_least_32_chars

# Allowed CORS Origins (comma-separated list of trusted frontend URLs)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# Demo / Development Authentication Bypass (strictly false in production)
ENABLE_DEMO_LOGIN=false

# Node Environment (development | production | test)
NODE_ENV=development
